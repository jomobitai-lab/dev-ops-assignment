# Copy to .env (docker compose reads it automatically).
#   cp .env.example .env

# ---- app ----
APP_PASSWORD=trackmate
SECRET_KEY=please-change-this-to-a-long-random-string
TOKEN_HOURS=720

# ---- database (used by the db service + the api connection string) ----
POSTGRES_USER=trackmate
POSTGRES_PASSWORD=trackmate
POSTGRES_DB=trackmate

# ---- host port the web UI is published on ----
WEB_PORT=3000
