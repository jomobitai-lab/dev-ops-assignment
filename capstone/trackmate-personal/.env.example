# Copy to .env for local dev, and set these in Vercel's Environment Variables for deploy.

# Neon (or any Postgres) POOLED connection string. Leave empty to use local SQLite.
# Get it from neon.tech -> your project -> Connection string (the one with "-pooler").
DATABASE_URL=

# The single password used to log in to the app.
APP_PASSWORD=change-this-password

# A long random string used to sign login tokens. Generate one, keep it secret.
SECRET_KEY=change-this-to-a-long-random-string
